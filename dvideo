      // สถานะแอปพลิเคชัน (App States)
      let mediaItems = [];
      let currentViewMode = "grid"; // grid | list
      let selectedCategory = "All";
      let selectedType = "all";
      let webAppUrl = "";

      // เริ่มทำงานเบื้องแรก
      window.onload = function() {
        // โหลด API URL จาก localStorage
        webAppUrl = localStorage.getItem('downloader_web_app_url') || "";
        document.getElementById('inputWebAppUrl').value = webAppUrl;

        // ดึงข้อมูลในเครื่องที่จำลองไว้มาโชว์ก่อน
        const savedMedia = localStorage.getItem('drive_sheet_media');
        mediaItems = savedMedia ? JSON.parse(savedMedia) : mockData;

        updateConnectionUI();
        renderCategories();
        renderMedia();

        // ซิงค์อัตโนมัติหากมีการเก็บ API URL ปลายทางไว้
        if (webAppUrl) {
          syncWithCloud();
        }
      };

      // อัปเดต UI หน้าจอสถานะออนไลน์/ออฟไลน์
      function updateConnectionUI() {
        const container = document.getElementById('connectionStatus');
        const indicator = document.getElementById('statusIndicator');
        const statusText = document.getElementById('statusText');

        container.classList.remove('hidden');
        if (webAppUrl) {
          indicator.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse";
          statusText.innerText = "เชื่อมต่อระบบ Cloud Sheet แล้ว";
        } else {
          indicator.className = "w-2.5 h-2.5 rounded-full bg-amber-500";
          statusText.innerText = "จำลองจัดเก็บชั่วคราว (Offline)";
        }
      }

      // ดึงข้อมูลจริงจาก Apps Script API
      async function syncWithCloud() {
        if (!webAppUrl) {
          showNotification('แนะนำการเชื่อมโยง', 'คุณสามารถแชร์พอร์ทัลดาวน์โหลดนี้ให้แก่เพื่อนร่วมงานได้ โดยการคลิกไอคอนฟันเฟืองด้านขวาบนเพื่อทำการผูกกับ Apps Script ขององค์กรเพื่อเปิดดึงฐานข้อมูลจริงแบบไร้รอยต่อ', 'info');
          return;
        }

        const loader = document.getElementById('loadingIndicator');
        loader.classList.remove('hidden');
        document.getElementById('loadingText').innerText = 'กำลังเชื่อมต่อฐานข้อมูล Google Sheets...';

        try {
          const response = await fetch(`${webAppUrl}?action=get`);
          const result = await response.json();

          if (result && Array.isArray(result)) {
            mediaItems = result;
            localStorage.setItem('drive_sheet_media', JSON.stringify(result));
            renderCategories();
            renderMedia();
            showNotification('ซิงค์ข้อมูลสมบูรณ์!', 'ดึงพิกัดไฟล์ภาพและวิดีโอล่าสุดจากตารางประวัติ Google Sheet สำเร็จเรียบร้อย', 'success');
          } else {
            showNotification('โครงสร้างไม่ถูกต้อง', 'โครงสร้างตารางข้อมูลที่ดึงมาไม่เข้ากันกับระบบนี้', 'error');
          }
        } catch (err) {
          console.error(err);
          showNotification('ขัดข้องในการซิงค์', 'เกิดข้อผิดพลาดด้านเครือข่าย กรุณาตรวจสอบว่าคุณได้ Deploy Google App Script แบบสิทธิ์ "Everyone (ทุกคน)" แล้วหรือไม่', 'error');
        } finally {
          loader.classList.add('hidden');
        }
      }

      // สร้างรายชื่อปุ่มหมวดหมู่ไดนามิก
      function renderCategories() {
        const container = document.getElementById('categoryPillContainer');
        const listCategories = ['All', ...new Set(mediaItems.map(item => item.category))];
        
        container.innerHTML = "";
        listCategories.forEach(cat => {
          const activeClass = selectedCategory === cat 
            ? "bg-indigo-600 text-white shadow-lg shadow-indigo-650/25" 
            : "bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-850";
            
          container.innerHTML += `
            <button 
              onclick="selectCategory('${cat}')" 
              class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all ${activeClass}"
            >
              ${cat}
            </button>
          `;
        });
      }

      // ดำเนินการกรองหมวดหมู่เมื่อคลิก
      function selectCategory(cat) {
        selectedCategory = cat;
        renderCategories();
        renderMedia();
      }

      function handleSearch() {
        renderMedia();
      }

      function handleFilterChange() {
        selectedType = document.getElementById('typeFilter').value;
        renderMedia();
      }

      function setViewMode(mode) {
        currentViewMode = mode;
        const btnGrid = document.getElementById('btnViewGrid');
        const btnList = document.getElementById('btnViewList');

        if (mode === 'grid') {
          btnGrid.className = "flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-white transition-all";
          btnList.className = "flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-350 transition-all";
        } else {
          btnGrid.className = "flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-355 transition-all";
          btnList.className = "flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-white transition-all";
        }
        renderMedia();
      }

      // ดาวน์โหลดไฟล์ไม่ลดความละเอียด
      function startDownload(id, driveId, url, title) {
        let downloadUrl = url;
        if (driveId && !driveId.includes('mock')) {
          downloadUrl = `https://drive.google.com/uc?export=download&id=${driveId}`;
        }
        
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.target = '_blank';
        link.setAttribute('download', title || 'media-download');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      // สั่งก็อปปี้ลิงก์
      function copyItemLink(text, id) {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
          showNotification('คัดลอกสำเร็จแล้ว!', 'ลิงก์ตรงสำหรับดาวน์โหลดสื่อนวัตกรรมถูกบันทึกในคลิปบอร์ดแล้ว', 'success');
        } catch (err) {
          console.error(err);
        }
        document.body.removeChild(textArea);
      }

      // เรนเดอร์การแสดงผลแกลเลอรี
