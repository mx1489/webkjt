      // เปิดหน้าตรวจสอบ Lightbox ชิ้นใหญ่
      function openLightbox(item) {
        const modal = document.getElementById('lightboxModal');
        const mediaWrapper = document.getElementById('lightboxMediaWrapper');
        
        document.getElementById('lightboxCategory').innerText = item.category.toUpperCase();
        document.getElementById('lightboxTitle').innerText = item.title;
        document.getElementById('lightboxDescription').innerText = item.description || "ไม่มีคำบรรยายสื่อนวัตกรรมนี้เพิ่มเติม";
        document.getElementById('lightboxUrlText').innerText = item.url;
        
        // เคลียร์และสร้างแท็ก
        const tagsContainer = document.getElementById('lightboxTags');
        const tagSection = document.getElementById('lightboxTagSection');
        tagsContainer.innerHTML = "";
        
        if (item.tags && item.tags.length > 0) {
          tagSection.classList.remove('hidden');
          item.tags.forEach(t => {
            tagsContainer.innerHTML += `<span class="text-[10px] bg-slate-950 text-slate-400 px-2 py-0.5 rounded border border-slate-800">#${t}</span>`;
          });
        } else {
          tagSection.classList.add('hidden');
        }

        // แทรก Tag ภาพนิ่งหรือวิดีโอ
        if (item.type === 'video') {
          mediaWrapper.innerHTML = `<video src="${item.url}" class="max-w-full max-h-[50vh] md:max-h-[80vh]" controls autoplay></video>`;
        } else {
          mediaWrapper.innerHTML = `<img src="${item.url}" alt="" class="max-w-full max-h-[50vh] md:max-h-[80vh] object-contain" />`;
        }

        // จัดเตรียมปุ่มดาวน์โหลด/ก๊อปปี้ลิงก์
        const dlBtn = document.getElementById('lightboxDownloadBtn');
        dlBtn.onclick = function() {
          startDownload(item.id, item.driveId, item.url, item.title);
        };

        const copyBtn = document.getElementById('lightboxCopyBtn');
        const copyText = document.getElementById('lightboxCopyText');
        copyText.innerText = "คัดลอกลิงก์ตรงเพื่อแชร์";
        
        copyBtn.onclick = function() {
          const textArea = document.createElement("textarea");
          textArea.value = item.url;
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            document.execCommand('copy');
            copyText.innerText = "คัดลอกลิงก์สำเร็จแล้ว!";
            setTimeout(() => { copyText.innerText = "คัดลอกลิงก์ตรงเพื่อแชร์"; }, 2000);
          } catch (err) {
            console.error(err);
          }
          document.body.removeChild(textArea);
        };

        modal.classList.remove('hidden');
      }

      function closeLightbox() {
        document.getElementById('lightboxModal').classList.add('hidden');
        document.getElementById('lightboxMediaWrapper').innerHTML = "";
      }

      // ระบบตั้งค่า API Web App สำหรับแอดมินมาเชื่อมโยงข้อมูล
      function openConfigModal() {
        document.getElementById('configModal').classList.remove('hidden');
      }

      function closeConfigModal() {
        document.getElementById('configModal').classList.add('hidden');
      }

      function saveConfig() {
        const urlInput = document.getElementById('inputWebAppUrl').value.trim();
        webAppUrl = urlInput;
        localStorage.setItem('downloader_web_app_url', urlInput);
        closeConfigModal();
        updateConnectionUI();
        
        if (urlInput) {
          syncWithCloud();
        } else {
          mediaItems = mockData;
          localStorage.removeItem('drive_sheet_media');
          renderCategories();
          renderMedia();
          showNotification('เปลี่ยนเป็นโหมดออฟไลน์', 'ระบบสลับฐานข้อมูลกลับเข้าสู่โหมดจำลองในอุปกรณ์นี้เรียบร้อยแล้ว', 'info');
        }
      }

      // แจ้งเตือนแบบ Custom (สวยงามและปลอดภัยบน Sandbox iFrame)
      function showNotification(title, message, type = 'info') {
        document.getElementById('alertTitle').innerText = title;
        document.getElementById('alertMessage').innerText = message;
        document.getElementById('customAlert').classList.remove('hidden');
      }

      function closeCustomAlert() {
        document.getElementById('customAlert').classList.add('hidden');
      }
    </script>

  </body>
</html>
