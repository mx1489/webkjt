<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Media Cloud Vault - คลังสื่อนวัตกรรมออนไลน์</title>
    <!-- นำเข้า Tailwind CSS สำหรับสไตล์หน้าจอพรีเมียม -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;850&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Sarabun', sans-serif;
      }
      /* ปรับแต่งซ่อน Scrollbar สำหรับปุ่มหมวดหมู่ */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <!-- ----------------- TOP NAVBAR ----------------- -->
    <header class="border-b border-slate-900 bg-slate-900/60 backdrop-blur-md sticky top-0 z-40 px-4 py-4 sm:px-6">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        
        <!-- แบรนด์โลโก้คลังสื่อ -->
        <div class="flex items-center gap-3">
          <div class="bg-indigo-600 p-2.5 rounded-xl text-white shadow-lg shadow-indigo-600/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <h1 class="text-lg sm:text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
              Media Cloud Vault
            </h1>
            <p class="text-[10px] sm:text-xs text-slate-400 font-medium">ศูนย์บริการจัดเก็บและดาวน์โหลดสื่อนวัตกรรมองค์กร</p>
          </div>
        </div>

        <!-- ปุ่มซิงค์ / ข้อมูลเชื่อมต่อ และไอคอนตั้งค่าแบบซ่อน (Admin Only) -->
        <div class="flex items-center gap-2">
          <div id="connectionStatus" class="hidden sm:flex items-center gap-1.5 bg-slate-900/80 px-3 py-1.5 rounded-xl border border-slate-800 text-[11px] text-slate-400">
            <span class="w-2 h-2 rounded-full bg-amber-500" id="statusIndicator"></span>
            <span id="statusText">โหมดเดโมออฟไลน์</span>
          </div>

          <button onclick="syncWithCloud()" class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white transition-all" title="รีเฟรชข้อมูลคลาวด์ล่าสุด">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H17" />
            </svg>
          </button>

          <!-- ไอคอนฟันเฟืองสำหรับแอดมินมาแปะ Web App URL แบบลับๆ -->
          <button onclick="openConfigModal()" class="p-2 rounded-xl bg-slate-950 hover:bg-slate-900 border border-slate-900 text-slate-500 hover:text-slate-300 transition-all" title="ตั้งค่าเชื่อมโยง Google API">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>

      </div>
    </header>

    <!-- ----------------- MAIN PORTAL ----------------- -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
      
      <!-- ส่วนต้อนรับและคำแนะนำ -->
      <div class="text-center space-y-3 py-4">
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
          ค้นพบและดาวน์โหลดสื่อนวัตกรรมคุณภาพสูง
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 max-w-2xl mx-auto leading-relaxed">
          ยินดีต้อนรับสู่พอร์ทัลสื่อนวัตกรรม คุณสามารถสืบค้น ค้นหา หรือแชร์ลิงก์ พร้อมทั้งกดดาวน์โหลดสื่อนวัตกรรมไฟล์ต้นฉบับดั้งเดิม (Original) แบบความละเอียดสูงสุด ไม่ลดทอนความละเอียด
        </p>
      </div>

      <!-- ส่วนค้นหาและเครื่องมือกรอง (Search & Filters) -->
      <div class="bg-slate-900/60 p-4 sm:p-6 rounded-3xl border border-slate-900 shadow-2xl backdrop-blur-md space-y-4">
        
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
          
          <!-- ช่องกรอกค้นหาข้อมูล -->
          <div class="relative md:col-span-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-500 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              type="text" 
              id="searchBox"
              oninput="handleSearch()"
              placeholder="สืบค้นชื่อสื่อ, แท็กคำค้นหา, หรือรายละเอียดเพิ่มเติม..." 
              class="w-full pl-11 pr-4 py-3 bg-slate-950 border border-slate-850 rounded-2xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-all text-sm sm:text-base"
            />
          </div>

          <!-- ตัวเลือกประเภทสื่อ -->
          <div class="relative md:col-span-3">
            <select 
              id="typeFilter"
              onchange="handleFilterChange()"
              class="w-full px-4 py-3.5 bg-slate-950 border border-slate-850 rounded-2xl text-slate-300 focus:outline-none appearance-none cursor-pointer text-sm font-semibold"
            >
              <option value="all">ชนิดสื่อทั้งหมด</option>
              <option value="image">รูปภาพเท่านั้น (Images)</option>
              <option value="video">วิดีโอเท่านั้น (Videos)</option>
            </select>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 absolute right-4 top-4.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>

          <!-- สวิตช์สลับมุมมอง Grid / List -->
          <div class="flex bg-slate-950 border border-slate-850 p-1 rounded-2xl md:col-span-3">
            <button 
              onclick="setViewMode('grid')"
              id="btnViewGrid"
              class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-white transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              ตาราง (Grid)
            </button>
            <button 
              onclick="setViewMode('list')"
              id="btnViewList"
              class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-300 transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              รายการ (List)
            </button>
          </div>

        </div>

        <!-- ตัวสไลด์ประเภทหมวดหมู่หลัก (Category Pills) -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1.5 no-scrollbar">
          <span class="text-[10px] sm:text-xs text-slate-500 font-extrabold uppercase tracking-wider mr-2 whitespace-nowrap">หมวดหมู่สื่อนวัตกรรม:</span>
          <div id="categoryPillContainer" class="flex items-center gap-2">
            <!-- หมวดหมู่แบบไดนามิกจะถูกใส่ที่นี่ -->
          </div>
        </div>

      </div>

      <!-- ข้อความแจ้งความคืบหน้าการโหลด -->
      <div id="loadingIndicator" class="hidden text-center py-12 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-650 border-t-transparent"></div>
        <p class="text-sm text-indigo-400 font-semibold" id="loadingText">กำลังดึงข้อมูลล่าสุด...</p>
      </div>

      <!-- ส่วนการแสดงผลแกลเลอรีหลัก -->
      <div id="mediaContainer">
        <!-- ข้อมูลทั้งหมดจะถูกเรนเดอร์ผ่าน JavaScript ตรงนี้ -->
      </div>

    </main>

    <!-- ----------------- FOOTER ----------------- -->
    <footer class="border-t border-slate-900 bg-slate-950 py-6 px-4 text-center text-xs text-slate-500 mt-12">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 font-sans">
        <p>© 2026 Media Cloud Vault. ทุกไฟล์สื่อนวัตกรรมถูกจัดเก็บไว้บนความปลอดภัยระดับคลาวด์</p>
        <div class="flex items-center gap-4">
          <span class="hover:text-slate-300 cursor-pointer">พอร์ทัลดาวน์โหลดสิทธิ์เข้าใช้งานร่วมกัน</span>
          <span>|</span>
          <span class="font-bold text-slate-400">Original Resolution Guaranteed (100%)</span>
        </div>
      </div>
    </footer>

    <!-- ----------------- LIGHTBOX PREVIEW MODAL ----------------- -->
    <div id="lightboxModal" class="hidden fixed inset-0 bg-slate-950/95 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 lg:p-8 z-50 animate-in fade-in duration-200">
      <div class="bg-slate-900 border border-slate-850 rounded-3xl w-full max-w-5xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[90vh]">
        
        <!-- ตัวพรีวิวรูปหรือวิดีโอเดโม -->
        <div class="flex-1 bg-black flex items-center justify-center relative min-h-[250px] md:min-h-0">
          <div id="lightboxMediaWrapper" class="w-full h-full flex items-center justify-center">
            <!-- จะถูกเรนเดอร์ Image / Video Tag -->
          </div>
        </div>

        <!-- รายละเอียดสื่อและการดาวน์โหลดในหน้า Lightbox -->
        <div class="w-full md:w-80 border-t md:border-t-0 md:border-l border-slate-800 p-6 flex flex-col justify-between overflow-y-auto bg-slate-900/60 backdrop-blur-sm">
          <div class="space-y-5">
            
            <div class="flex justify-between items-start">
              <div>
                <span id="lightboxCategory" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-950 border border-slate-800 text-slate-300">
                  CATEGORY
                </span>
                <h3 id="lightboxTitle" class="font-bold text-white text-lg mt-2 leading-tight">MEDIA TITLE</h3>
              </div>
              <button onclick="closeLightbox()" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <div class="space-y-1">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-widest block">คำอธิบายภาพ</span>
              <p id="lightboxDescription" class="text-slate-300 text-xs leading-relaxed">คำบรรยายสื่อนวัตกรรม...</p>
            </div>

            <div class="space-y-1" id="lightboxTagSection">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-widest block">แท็กสืบค้น</span>
              <div id="lightboxTags" class="flex flex-wrap gap-1">
                <!-- แท็กจะเรนเดอร์ที่นี่ -->
              </div>
            </div>

            <div class="border-t border-slate-800/80 my-2"></div>

            <div class="space-y-2">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-widest block font-mono">Drive URL direct</span>
              <div class="bg-slate-950 border border-slate-850 p-2.5 rounded-xl space-y-1">
                <code id="lightboxUrlText" class="text-[10px] text-indigo-400 font-mono block select-all truncate">URL</code>
              </div>
            </div>

          </div>

          <!-- ปุ่มกระทำหลัก (Download & Share) -->
          <div class="pt-6 space-y-2 mt-6">
            <button 
              id="lightboxDownloadBtn"
              class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-3 rounded-2xl text-xs transition-colors shadow-lg shadow-emerald-600/20"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              ดาวน์โหลดต้นฉบับดั้งเดิม (ไม่ลดคุณภาพ)
            </button>
            
            <button 
              id="lightboxCopyBtn"
              class="w-full flex items-center justify-center gap-2 bg-slate-850 hover:bg-slate-800 text-slate-300 font-semibold py-2.5 rounded-2xl text-xs transition-all border border-slate-750"
            >
              <span id="lightboxCopyText">คัดลอกลิงก์ CDN ตรง</span>
            </button>
          </div>

        </div>

      </div>
    </div>

    <!-- ----------------- CONFIG API MODAL (HIDDEN SETTING) ----------------- -->
    <div id="configModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-in fade-in duration-150">
      <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-md overflow-hidden shadow-2xl">
        
        <div class="p-6 border-b border-slate-800 bg-slate-950/40 flex justify-between items-center">
          <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm sm:text-base">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
            กำหนดค่าการเชื่อมต่อคลาวด์
          </h3>
          <button onclick="closeConfigModal()" class="p-1.5 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6 space-y-4">
          <p class="text-xs text-slate-400 leading-relaxed font-sans">
            ใส่ **Google Web App URL** ที่แอดมินสร้างจาก Google Apps Script ในฝั่ง Google Sheet เพื่อดึงพิกัดไฟล์และอัปเดตข้อมูลมัลติมีเดียโดยตรงในเวลาเดียวกัน
          </p>

          <div class="space-y-1.5">
            <label class="text-xs text-slate-400 font-bold">Google Web App URL (Apps Script)</label>
            <input 
              type="url" 
              id="inputWebAppUrl"
              placeholder="https://script.google.com/macros/s/.../exec"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-2xl text-xs text-slate-350 focus:outline-none"
            />
          </div>

          <div class="flex gap-3 pt-3">
            <button onclick="closeConfigModal()" class="flex-1 bg-slate-950 hover:bg-slate-850 text-slate-400 py-2.5 rounded-xl border border-slate-850 text-xs font-semibold">
              ยกเลิก
            </button>
            <button onclick="saveConfig()" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white py-2.5 rounded-xl text-xs font-bold shadow-lg shadow-indigo-600/20">
              บันทึกการเชื่อมต่อ
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- ----------------- CUSTOM NOTIFICATION ALERT ----------------- -->
    <div id="customAlert" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-in fade-in duration-100">
      <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-sm overflow-hidden shadow-2xl">
        <div class="p-6 space-y-4 text-center">
          <div class="inline-flex p-3 rounded-full bg-indigo-950/80 text-indigo-400 border border-indigo-900/40 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 id="alertTitle" class="font-bold text-slate-100 text-sm sm:text-base">TITLE</h3>
          <p id="alertMessage" class="text-xs text-slate-400 leading-relaxed font-sans">MESSAGE</p>
          <button onclick="closeCustomAlert()" class="w-full bg-slate-850 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl text-xs border border-slate-750 transition-all">
            เข้าใจแล้ว
          </button>
        </div>
      </div>
    </div>

    <!-- ----------------- JAVASCRIPT PROGRAMMING ----------------- -->
    <script>
      // ชุดข้อมูลจำลองเริ่มต้นสำหรับแสดงความสวยงามทันทีก่อนเชื่อม Google Sheets จริง
      const mockData = [
        {
          id: "1",
          title: "ภูเขาและหมอกยามเช้า",
          category: "Nature",
          type: "image",
          url: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80",
          driveId: "1A2B3C4D5E_mock_image_1",
